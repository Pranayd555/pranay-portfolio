    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/three": "^0.182.0",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
